Options -Indexes
DirectoryIndex index.html

# Enable Force HTTPS Redirect in cPanel after SSL is active.
# Do not add manual HTTPS rewrite rules here unless cPanel redirect fails.

# SECURITY_HARDENING_V1
# Bloqueia download directo de arquivos, bases de dados e ficheiros de
# log/backup mesmo que cheguem por engano à document root. As acções de
# backup do admin servem o ficheiro via PHP (Content-Disposition) e não
# dependem de acesso directo.
<FilesMatch "\.(zip|7z|tar|gz|tgz|bz2|rar|sqlite|sqlite-journal|sqlite-wal|sqlite-shm|sql|db|bak|backup|log|jsonl|tmp|swp|legacy|old|docx|py|bat|ps1|mhtml)$">
    Require all denied
</FilesMatch>

# As copias de seguranca dos editores chamam-se, por exemplo,
# "<produto>.json.galeria-bak", "<ficheiro>.json.precos-bak" e
# "faqs.json.faqs-bak". O sufixo tem um hifen antes de "bak", por isso a regra
# acima nao as apanha.
<FilesMatch "-(bak|backup)$">
    Require all denied
</FilesMatch>

# Bloqueia ficheiros dot, configuracoes internas e miu-defaults.json (contém system prompt e knowledge base)
<FilesMatch "^(\.|miaandpaper-mail-config|miu-config|admin-login-attempts|seo-state\.json|miu-defaults\.json).*$">
    Require all denied
</FilesMatch>

<Files "miu-defaults.json">
    Require all denied
</Files>

# Caminhos de trabalho que chegaram a existir no live. O deploy e aditivo, por
# isso estas respostas continuam a fechar copias antigas mesmo depois de os
# ficheiros sairem do repositorio.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(?:media_tiago|mockups|local-test-data)(?:/|$) - [G,L,NC]
    RewriteRule ^(?:modulos-temp\.html|log_css_mods\.txt|biscoito\.txt|reviews\.txt|README\.txt)$ - [G,L,NC]
    RewriteRule ^content/designs/cadernos/process/_image_tags\.json$ - [G,L,NC]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # Os editores usam previews do próprio site em iframe. Bloqueia origens
    # externas sem impedir esses previews administrativos same-origin.
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Permissions-Policy "camera=(), geolocation=(), microphone=(self), payment=(), usb=()"
    Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; object-src 'self'; script-src 'self' 'unsafe-inline' https://unpkg.com; style-src 'self' 'unsafe-inline' https://unpkg.com; img-src 'self' data: blob: https://unpkg.com https://*.tile.openstreetmap.org; media-src 'self' blob:; font-src 'self' data:; connect-src 'self'; frame-src 'self' https://www.youtube-nocookie.com; worker-src 'self' blob:"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on'"

    <FilesMatch "\.(?:html?|php|json)$">
        Header always set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
    <FilesMatch "\.(?:css|js)$">
        Header always set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(?:webp|jpe?g|png|gif|svg|ico|woff2?)$">
        Header always set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 0 seconds"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>
