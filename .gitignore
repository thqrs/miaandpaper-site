# ============================================================
# Mia & Paper - regras de exclusao do Git
# ============================================================

# --- Pastas locais que nao devem ir para o repo ---
private/
private-local/
imagens/
.claude/
local-test-data/
audios/

# --- Backups e arquivos pessoais (defensivo, ja foram movidos) ---
_deploy_backups/
_manual_backups/
*.mhtml
*.7z
*.zip

# --- Lixo gerado pelo servidor cPanel/PHP ---
# nunca deve ir para o repo, mesmo que o sync do cPanel o traga
site/error_log
site/.php-version-check.php
site/.well-known/
site/*.zip
site/*.7z

# --- Pasta antiga (apagada do disco; defensivo) ---
intermedio/

# --- Logs e temporarios ---
*.log
tmp/
.cache/

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# --- Segredos: nunca committar ---
.env
.env.*
*.key
*.pem
*.crt

# --- Bases de dados locais ---
*.sqlite
*.sqlite-journal
*.db

site/novos_designs/
novos_designs/
*.exe

# Cópias de segurança criadas pela galeria ao gravar um produto
*.galeria-bak

# Cópias de segurança criadas pelo editor de preços (precos.php)
*.precos-bak
*.homepage-bak
*.faqs-bak

# Cache de dimensões das imagens (gerado pela galeria)
site/content/.galeria-dimensoes.json

# --- Ficheiros de trabalho local (backups manuais, folhas de calculo, mockups) ---
*.xlsx
/cadernos - backup.json
/cadernos - super backup sem glossy.json
/catalogo-tracking-corrigido.txt
/metro_live_visitors_mockup.html
